# YouTube Data API v3 key (https://console.cloud.google.com/)
YOUTUBE_API_KEY=your_key_here

# Used for saving videos from a playlist
# OAuth client for account commands, e.g. `grabbag` (create an
# "OAuth client ID" of type "Desktop app" at console.cloud.google.com,
# APIs & Services > Credentials)
YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here
